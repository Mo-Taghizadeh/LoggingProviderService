{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "LoggingDb": "Server=.;Database=LogDb;Trusted_Connection=True;MultipleActiveResultSets=True;TrustServerCertificate=True"
  },
  "LoggingProvider": {
    "Enabled": true,
    "MaxBodyBytes": 65536,
    "LogHeaders": true
  }
}
